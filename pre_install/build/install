#!/bin/bash

set -eu

echo '#!/bin/sh' > /usr/sbin/policy-rc.d
echo 'exit 101' >> /usr/sbin/policy-rc.d
chmod +x /usr/sbin/policy-rc.d
dpkg-divert --local --rename --add /sbin/initctl
cp -a /usr/sbin/policy-rc.d /sbin/initctl
sed -i 's/^exit.*/exit 0/' /sbin/initctl
export DEBIAN_FRONTEND=noninteractive
export LC_ALL=C
export INITRD=no
dpkg-divert --local --rename --add /sbin/initctl
ln -sf /bin/true /sbin/initctl
dpkg-divert --local --rename --add /usr/bin/ischroot
ln -sf /bin/true /usr/bin/ischroot

# Dependencies
sed -i 's/^#\s*\(deb.*main restricted\)$/\1/g' /etc/apt/sources.list
sed -i 's/^#\s*\(deb.*universe\)$/\1/g' /etc/apt/sources.list
sed -i 's/^#\s*\(deb.*multiverse\)$/\1/g' /etc/apt/sources.list

# Optional APT caching, speeds up local builds
apt update
apt -yq install auto-apt-proxy
auto-apt-proxy

apt -yq dist-upgrade
apt -yq install --no-install-recommends \
	adduser \
	apt-transport-https \
	ca-certificates \
	curl \
	dirmngr \
	gnupg \
	python3 \
	runit

mkdir -p /etc/my_init.d /etc/my_init.pre_shutdown.d /etc/my_init.post_shutdown.d /etc/container_environment
chmod 700 /etc/container_environment
echo -n no > /etc/container_environment/INITRD
touch /etc/container_environment.sh
touch /etc/container_environment.json
groupadd -g 8377 docker_env
chown :docker_env /etc/container_environment.sh /etc/container_environment.json
chmod 640 /etc/container_environment.sh /etc/container_environment.json
ln -s /etc/container_environment.sh /etc/profile.d/

# runit
rm /etc/service
mkdir /etc/service

# cron
apt -yq install --no-install-recommends cron
chmod 600 /etc/crontab
find /etc/cron.daily/ -maxdepth 1 -type f -delete
find /etc/cron.weekly/ -maxdepth 1 -type f -delete

# syslog-ng
apt -yq -o Dpkg::Options::="--force-confold" install --no-install-recommends syslog-ng-core
mkdir -p /var/lib/syslog-ng
touch /var/log/syslog
chmod u=rw,g=r,o= /var/log/syslog

# logrotate
apt -yq install --no-install-recommends logrotate

# Remove default user
deluser ubuntu
rm -rf /home/ubuntu

# Permissions
find /etc/service -name 'run' -mindepth 2 -maxdepth 2 -type f -exec chmod +x "{}" \;
chmod +x /usr/sbin/my_init /usr/sbin/setuser

# Cleanup
apt -yq autoremove --purge
apt clean
rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/cache/*
rm -f /var/log/dpkg.log /var/log/alternatives.log /var/log/bootstrap.log
rm -f /var/log/apt/history.log /var/log/apt/term.log
rm -rf /usr/share/groff/* /usr/share/info/*
rm -rf /usr/share/lintian/* /usr/share/linda/*
find /usr/share/man -type f -delete
find /usr/share/doc -not -type d -not -name 'copyright' -delete
find /usr/share/doc -type d -empty -delete

# Overwrite defaults with configuration from post_install
cp -ar /build/post_install/. /

chmod -R +x /etc/my_init.d /etc/service
find /etc/logrotate.d/ -type f -exec chmod 644 {} \;
