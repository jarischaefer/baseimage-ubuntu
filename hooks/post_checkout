#!/bin/bash

set -eu

curl -qsSL "https://github.com/multiarch/qemu-user-static/releases/download/v7.2.0-1/qemu-arm-static.tar.gz" | tar -xz
curl -qsSL "https://github.com/multiarch/qemu-user-static/releases/download/v7.2.0-1/qemu-aarch64-static.tar.gz" | tar -xz

chmod 755 qemu-arm-static qemu-aarch64-static
